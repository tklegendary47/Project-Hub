# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
PORT=5000
NODE_ENV=development

# Database — MongoDB Atlas connection string (free tier is fine to start)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/beacon?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — the URL your frontend is served from
CLIENT_ORIGIN=http://localhost:8080

# AI provider keys (only needed once you swap the mock checker for real calls)
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
